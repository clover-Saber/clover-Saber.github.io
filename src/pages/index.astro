---
import Profile from "@/components/Profile.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
const posts = (await getAllPosts()).sort(collectionDateSort).slice(0, 5);
---
<PageLayout meta={{ title: "首页" }}>
  <Profile />
  <section class="mt-16">
    <h2 class="title text-accent mb-6 text-xl"><a href="/posts/">文章</a></h2>
    {posts.length ? <ul class="space-y-4" role="list">{posts.map(post => <li class="grid gap-1 sm:grid-cols-[auto_1fr]"><PostPreview post={post} /></li>)}</ul> : <p class="text-muted">文章整理中。</p>}
  </section>
  <section class="mt-16">
    <h2 class="title text-accent mb-6 text-xl"><a href="/projects/">项目</a></h2>
    <p class="text-muted">项目整理中。</p>
  </section>
</PageLayout>
